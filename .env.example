# ---------------------------------------------------------------------------
# Infinite Accounting Services — environment configuration
# Copy to .env.local (local dev) or set in your host's dashboard, then rebuild.
# All values are read at BUILD time (static export), so rebuild after changes.
# ---------------------------------------------------------------------------

# Lead form endpoint. The contact form POSTs JSON here.
# Use any webhook that can send an email + SMS, e.g. a Zapier / Make scenario,
# Formspree, Basin, or your own serverless function. Configure it to:
#   - email  danielle@infiniteaccountingservices.com
#   - text   (708) 232-3003
# The payload includes notify_email and notify_sms so one webhook can route both.
NEXT_PUBLIC_LEAD_WEBHOOK_URL=

# Optional: Google reCAPTCHA v3 site key. When set, the form requests a token
# and sends it as "recaptcha_token" for your endpoint to verify server-side.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Google Analytics 4 measurement ID (placeholder G-XXXXXXXXXX = analytics off).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console HTML-tag verification token (content="..." value only).
NEXT_PUBLIC_GSC_VERIFICATION=

# Google Business Profile "write a review" link, once the profile is verified.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Optional: AI chat widget script URL (loaded into the reserved slot before </body>).
NEXT_PUBLIC_CHAT_WIDGET_SRC=
